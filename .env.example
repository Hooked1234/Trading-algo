# IB Gateway paper defaults; port 7497 is TWS paper, 4002 commonly IB Gateway paper.
TRADING_IBKR_HOST=127.0.0.1
TRADING_IBKR_PORT=7497
TRADING_IBKR_CLIENT_ID=71
