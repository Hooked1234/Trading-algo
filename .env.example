# Copy to .env locally. Never paste credentials into chat or commit them.
TRADING_ENVIRONMENT=paper
TRADING_PAPER_ACCOUNT_ID=DU1234567
TRADING_ALLOWED_PAPER_ACCOUNTS='["DU1234567"]'
TRADING_SEC_USER_AGENT="event-trader local-contact@example.invalid"
# Created only by the passed research/model/paired gate workflow.
TRADING_PROMOTION_ARTIFACT_PATH=data/state/promotion.json
TRADING_HISTORICAL_ELIGIBILITY_PATH=data/reference/historical_eligibility.csv

# Optional historical Alpaca SIP access
